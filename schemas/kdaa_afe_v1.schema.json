{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kdaa.afe.v1",
  "description": "AFE -> LM Server contract (spec 3.2). Semantic rules JSON Schema cannot express (alts sum to 1, probability-descending order, keytype derived from top-1, contiguous idx) are enforced by src/schema.py::validate_document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sample_rate", "session_id", "lang", "tokens", "meta"],
  "properties": {
    "schema": { "const": "kdaa.afe.v1" },
    "sample_rate": { "const": 48000 },
    "session_id": { "type": "string" },
    "lang": { "enum": ["ko"] },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idx", "onset_s", "keytype", "alts"],
        "properties": {
          "idx": { "type": "integer", "minimum": 0 },
          "onset_s": { "type": "number" },
          "keytype": { "enum": ["normal", "space", "backspace", "shift", "caps", "other"] },
          "alts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 38,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["jamo", "p"],
              "properties": {
                "jamo": { "$ref": "#/$defs/symbol" },
                "p": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "topN", "input_shape", "calibrated"],
      "properties": {
        "model_id": { "type": "string" },
        "topN": { "type": "integer", "minimum": 1, "maximum": 38 },
        "input_shape": {
          "type": "array",
          "prefixItems": [{ "const": 1 }, { "const": 64 }, { "const": 48 }],
          "minItems": 3,
          "maxItems": 3
        },
        "calibrated": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "symbol": {
      "enum": [
        "ㄱ", "ㄴ", "ㄷ", "ㄹ", "ㅁ", "ㅂ", "ㅅ", "ㅇ", "ㅈ", "ㅊ", "ㅋ", "ㅌ", "ㅍ", "ㅎ",
        "ㄲ", "ㄸ", "ㅃ", "ㅆ", "ㅉ",
        "ㅏ", "ㅐ", "ㅑ", "ㅓ", "ㅔ", "ㅕ", "ㅗ", "ㅛ", "ㅜ", "ㅠ", "ㅡ", "ㅣ",
        "ㅒ", "ㅖ",
        "<sp>", "<bs>", "<shift>", "<caps>", "<other>"
      ]
    }
  }
}
